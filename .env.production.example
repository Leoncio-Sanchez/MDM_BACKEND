# ==============================================================================
# Producción — Sistema LF-ITSE. Copiar a .env en el servidor y completar (ver DEPLOY.md).
# Aquí solo hay valores de ejemplo. El .env real nunca se sube al repositorio.
# Generar las claves en hexadecimal: Docker Compose interpreta el signo $ de este archivo.
# ==============================================================================

# --- nginx-proxy y acme-companion ---
VIRTUAL_HOST=api.ejemplo.gob.pe
VIRTUAL_PORT=80
LETSENCRYPT_HOST=api.ejemplo.gob.pe
LETSENCRYPT_EMAIL=ti@ejemplo.gob.pe

# --- Aplicación ---
APP_NAME="Sistema LF-ITSE"
APP_ENV=production
APP_DEBUG=false
# echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=https://api.ejemplo.gob.pe
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Proxy y CORS ---
# Subred de la red "web": docker network inspect web -f '{{(index .IPAM.Config 0).Subnet}}'
# Sin esto, Laravel no detecta HTTPS y todos los usuarios comparten un solo límite de intentos.
TRUSTED_PROXIES=172.18.0.0/16
# Dominios del frontend, separados por comas, con https:// y sin barra final. "*" se ignora.
CORS_ALLOWED_ORIGINS=https://lf-itse.ejemplo.gob.pe

# --- Logs: van a Docker, que los rota (docker compose logs app) ---
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de datos ---
# Se usa el nombre del contenedor: "pgsql" podría confundirse con otra app de la red compartida
DB_CONNECTION=pgsql
DB_HOST=mdm_pgsql
DB_PORT=5432
DB_DATABASE=mdm_lf_itse
DB_USERNAME=mdm_app
# openssl rand -hex 32
DB_PASSWORD=

# --- Redis: caché y límites de intentos ---
CACHE_STORE=redis
REDIS_CLIENT=phpredis
# Mismo motivo que DB_HOST
REDIS_HOST=mdm_redis
REDIS_PORT=6379
# openssl rand -hex 32
REDIS_PASSWORD=

# --- Sesiones, colas y correo: la API no los usa ---
# Autenticación por JWT, sin sesiones
SESSION_DRIVER=array
# El código no despacha trabajos ni tiene tareas programadas: no hay worker ni scheduler
QUEUE_CONNECTION=sync
# El código no envía correos
MAIL_MAILER=log
BROADCAST_CONNECTION=log

# --- JWT ---
# Instalación nueva: openssl rand -hex 64
# Si se importan datos de Django y se quiere conservar las sesiones abiertas: la clave de Django
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- PIDE: RENIEC y SUNAT ---
# Credenciales de la municipalidad. Vacías: la consulta falla y los datos se escriben a mano.
RENIEC_URL=https://ws2.pide.gob.pe/Rest/RENIEC/Consultar
RENIEC_NUDNIUSUARIO=
RENIEC_NURUCUSUARIO=
RENIEC_PASSWORD=
RENIEC_TIMEOUT=10
SUNAT_URL=https://ws3.pide.gob.pe/Rest/Sunat/DatosPrincipales

# --- Adjuntos ---
# NO cambiar: es donde compose.prod.yaml monta el volumen mdm_media
MEDIA_DISK_ROOT=/var/www/media
FILESYSTEM_DISK=local

# --- Reglas del negocio ---
# Fecha (AAAA-MM-DD) desde la que el certificado ITSE exige un acta Aprobada, según la recepción
# del expediente. Vacío = se exige a todos. La define la municipalidad.
ITSE_ACTA_OBLIGATORIA_DESDE=

# --- Documentación de la API ---
# false: /api/documentation responde 404 en producción
L5_SWAGGER_PUBLICO=false
